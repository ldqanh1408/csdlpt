flowchart LR
    EV["Event đến<br/>(theo từng partition)"]
    subgraph T1G["Tier-1: RocksDB cục bộ (local) trên nút sở hữu (node owner)"]
        A["RocksDB P0/P1/P2 - nút (node) W1"]
        B["RocksDB P3/P4/P5 - nút (node) W2"]
    end
    SV[("Tier-2: Shared Volume<br/>/data/checkpoint/partition_k/")]
    T3[("Tier-3: MinIO<br/>(cửa sổ - window đã đóng)")]

    EV -->|"ghi ngay, dưới 1ms"| T1G
