%% Cấu trúc thư mục Tiered Storage (3 tầng)
flowchart TB
    subgraph LOCAL["Tier-1 - cục bộ (local) mỗi nút (node): /data/rocksdb/"]
        P0["partition_0/  (thể hiện RocksDB riêng biệt - RocksDB instance)"]
        P0K["phím (keys): ow / cw / si / meta<br/>(open window, closed window, seen-id, metadata)"]
        P1["partition_1/  ..."]
        P0 -->|"cấu trúc RocksDB"| P0K
    end

    subgraph SHARED["Tier-2 - Phân vùng chia sẻ (Shared Volume): /data/checkpoint/"]
        C0["partition_0/"]
        M["metadata.json - offset, các cửa sổ hoạt động (active windows), term"]
        S["state.db/ - các tệp tin SST (SST files) của RocksDB"]
        SK["sketch.bin - trạng thái DDSketch (DDSketch state) (chỉ dành cho Heuristic)"]
        C0 -->|"tệp cấu hình"| M
        C0 -->|"tệp trạng thái"| S
        C0 -->|"tệp sketch"| SK
    end

    subgraph OBJ["Tier-3 - MinIO bucket"]
        H["strict-watermark/historical/{partition}/{window_id}.json"]
        BK["active_state_backup/partition_{id}/{ts}_active.json"]
        DR["disaster_recovery/ ..."]
    end

    LOCAL -->|"checkpoint 10 giây (Tier-1 -> Tier-2)"| SHARED
    SHARED -.->|"lưu trữ (archive) cửa sổ (window) đã đóng / sao lưu DR (backup DR)"| OBJ
