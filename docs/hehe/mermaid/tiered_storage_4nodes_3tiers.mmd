%% Tiered Storage - 4 Worker node quản lý 12 partition trên 3 tier
flowchart TB
    C["Coordinator<br/>bảng ownership partition"]
    K["Kafka topic events<br/>12 partition: P0..P11"]

    subgraph N1["Node W1"]
        W1["Worker W1<br/>owner: P0, P1, P2"]
        W1T1[("Tier-1 local RocksDB<br/>namespace: P0, P1, P2")]
        W1 -->|"cập nhật từng event<br/>open window, dedup, offset"| W1T1
    end

    subgraph N2["Node W2"]
        W2["Worker W2<br/>owner: P3, P4, P5"]
        W2T1[("Tier-1 local RocksDB<br/>namespace: P3, P4, P5")]
        W2 -->|"cập nhật từng event<br/>open window, dedup, offset"| W2T1
    end

    subgraph N3["Node W3"]
        W3["Worker W3<br/>owner: P6, P7, P8"]
        W3T1[("Tier-1 local RocksDB<br/>namespace: P6, P7, P8")]
        W3 -->|"cập nhật từng event<br/>open window, dedup, offset"| W3T1
    end

    subgraph N4["Node W4"]
        W4["Worker W4<br/>owner: P9, P10, P11"]
        W4T1[("Tier-1 local RocksDB<br/>namespace: P9, P10, P11")]
        W4 -->|"cập nhật từng event<br/>open window, dedup, offset"| W4T1
    end

    T2[("Tier-2 Shared Checkpoint<br/>key: partition_id/checkpoint_version<br/>state + Kafka offset + owner_epoch")]
    T3[("Tier-3 MinIO/Object Storage<br/>key: partition_id/window_id<br/>closed window + archive + DR backup")]

    C -->|"assign P0-P2"| W1
    C -->|"assign P3-P5"| W2
    C -->|"assign P6-P8"| W3
    C -->|"assign P9-P11"| W4

    K -->|"poll P0-P2"| W1
    K -->|"poll P3-P5"| W2
    K -->|"poll P6-P8"| W3
    K -->|"poll P9-P11"| W4

    W1T1 -->|"checkpoint 10s<br/>theo từng partition"| T2
    W2T1 -->|"checkpoint 10s<br/>theo từng partition"| T2
    W3T1 -->|"checkpoint 10s<br/>theo từng partition"| T2
    W4T1 -->|"checkpoint 10s<br/>theo từng partition"| T2

    W1T1 ==>|"window đã đóng<br/>upload archive"| T3
    W2T1 ==>|"window đã đóng<br/>upload archive"| T3
    W3T1 ==>|"window đã đóng<br/>upload archive"| T3
    W4T1 ==>|"window đã đóng<br/>upload archive"| T3

    W1T1 -.->|"backup DR 5 phút<br/>window đang mở"| T3
    W2T1 -.->|"backup DR 5 phút<br/>window đang mở"| T3
    W3T1 -.->|"backup DR 5 phút<br/>window đang mở"| T3
    W4T1 -.->|"backup DR 5 phút<br/>window đang mở"| T3

    T2 -->|"failover/failback<br/>node mới đọc checkpoint theo partition_id"| W1
    T2 -->|"failover/failback<br/>node mới đọc checkpoint theo partition_id"| W2
    T2 -->|"failover/failback<br/>node mới đọc checkpoint theo partition_id"| W3
    T2 -->|"failover/failback<br/>node mới đọc checkpoint theo partition_id"| W4

    T3 -.->|"audit hoặc DR restore<br/>đọc theo partition/window"| T2
