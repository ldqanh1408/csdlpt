%% Kafka (append-only) + Bounded Priority Queue tại Worker
flowchart TB
    K["Kafka partition<br/>append-only, FIFO theo offset"]
    subgraph W["Nút Worker (Worker node)"]
        POLL["Luồng NẠP (poll)<br/>+ backpressure"]
        BPQ["Bounded Min-Heap (RAM)<br/>sắp xếp theo event_time<br/>maxsize + max_wait 1000ms"]
        DRAIN["Luồng XỬ LÝ (drain)<br/>pop theo event_time + loại bỏ trùng lặp (dedupe)"]
        RDB["RocksDB (trạng thái state đã sắp xếp)"]
        POLL -->|"đưa vào heap"| BPQ
        BPQ -->|"pop phần tử nhỏ nhất"| DRAIN
        DRAIN -->|"ghi trạng thái state tích lũy"| RDB
    end
    K -->|"consumer.poll() (pull)"| POLL
    POLL -.->|"hàng đợi (queue) đầy thì tạm dừng (pause); vơi thì tiếp tục (resume)"| K
