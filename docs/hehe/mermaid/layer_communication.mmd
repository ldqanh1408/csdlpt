flowchart LR
    ING["Ingestor"]
    K["Kafka"]
    W["Worker"]
    CTRL["Coordinator / Aggregator"]
    ST["Storage Tier2/Tier3"]
    ING -->|"Kafka produce: events + punctuation"| K
